{
  "name": "ksa-control-center",
  "productName": "KSA Control Center",
  "version": "0.2.1",
  "description": "An independent desktop launcher and community mod manager for Kitten Space Agency.",
  "private": true,
  "license": "MIT",
  "author": "KSA Control Center contributors",
  "main": "src/main.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/core.js && node --check src/renderer.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test:ui": "node test/ui-smoke.cjs"
  },
  "dependencies": { "adm-zip": "0.6.1", "smol-toml": "1.9.0" },
  "devDependencies": { "electron": "44.4.5", "electron-builder": "26.15.3", "@playwright/test": "1.63.0" },
  "build": {
    "appId": "io.ksa.community.controlcenter",
    "files": ["src/**/*", "assets/**/*", "package.json", "LICENSE", "THIRD_PARTY.md"],
    "directories": { "output": "dist" },
    "linux": { "target": ["AppImage"], "category": "Game", "icon": "assets/icon.png" },
    "win": { "target": ["portable"], "icon": "assets/icon.png" }
  }
}
